# PayPhone — NO son las mismas credenciales en dev y prod (el comentario anterior
# decía lo contrario y era falso: el token que estaba acá era el de DEV).
#
# El token real de producción vive SOLO en las variables de entorno de Vercel.
# Se comprobó que process.env le gana a este archivo en Vite, así que dejarlo
# vacío no afecta el build de Vercel — y evita que un build local termine
# cobrando con la credencial equivocada, que es lo que pasaría si quedara el
# valor viejo.
VITE_PAYPHONE_TOKEN=
VITE_PAYPHONE_STORE_ID=341b8815-9c6a-462a-a086-1e458d956d71

# URL del backend. La de Vercel ya apunta a https://api.boloncity.com/api y es la
# que manda; esta queda como respaldo para un build local.
VITE_API_BASE_URL=https://api.boloncity.com/api

# Meta Pixel. El access token de Conversions API vive SOLO en el backend.
VITE_META_PIXEL_ID=1327396295923548

# Google Tag Manager. No es secreto: viaja en el navegador.
VITE_GTM_ID=GTM-NCZLNBH3
